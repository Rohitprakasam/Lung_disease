# Flask & JWT Secrets
SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-in-production

# Database
DATABASE_URL=sqlite:///lung.db

# File Storage & Fernet Encryption Key
STORAGE_DIR=storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Feature Flags
HEALTHY_TWIN_ENABLED=true
SCAN_MEMORY_ENABLED=false
ALLOW_ANONYMOUS_PREDICT=true
DEMO_MODE=true

# CORS & Upload Limits
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_CONTENT_LENGTH=15728640

